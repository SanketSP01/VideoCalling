<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".VideoCallActivity">

    <!-- Remote video (full screen) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_remote_video" />

    <!-- Connection status text at top -->
    <TextView
        android:id="@+id/text_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:text="@string/status_connecting"
        android:textColor="@color/colorStatusText"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:background="#40000000" />

    <!-- Local video (picture-in-picture, top-right) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_local_video"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:elevation="8dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/colorSurface">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_local_video" />

    </androidx.cardview.widget.CardView>

    <!-- Bottom controls overlay -->
    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="32dp"
        android:paddingHorizontal="24dp"
        android:background="@drawable/bg_controls_gradient">

        <!-- Toggle Microphone -->
        <ImageButton
            android:id="@+id/btn_toggle_audio"
            style="@style/Widget.VideoCall.ControlButton"
            android:layout_marginHorizontal="12dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="@string/cd_toggle_audio" />

        <!-- Toggle Camera -->
        <ImageButton
            android:id="@+id/btn_toggle_video"
            style="@style/Widget.VideoCall.ControlButton"
            android:layout_marginHorizontal="12dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="@string/cd_toggle_video" />

        <!-- End Call -->
        <ImageButton
            android:id="@+id/btn_end_call"
            style="@style/Widget.VideoCall.EndCallButton"
            android:layout_marginHorizontal="12dp"
            android:src="@android:drawable/ic_menu_call"
            android:contentDescription="@string/cd_end_call" />

        <!-- Switch Camera -->
        <ImageButton
            android:id="@+id/btn_switch_camera"
            style="@style/Widget.VideoCall.ControlButton"
            android:layout_marginHorizontal="12dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="@string/cd_switch_camera" />

    </LinearLayout>

</FrameLayout>
